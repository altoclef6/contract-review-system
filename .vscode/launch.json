{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: contract_review",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "contract_review.main:app",
        "--reload",
        "--app-dir",
        "src",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}\\.env"
    }
  ]
}
