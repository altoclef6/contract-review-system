APP_NAME=企业级多源合同智能审查系统 API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# Upload and report storage
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
MAX_UPLOAD_SIZE_MB=50

# External LLM API only. Do not configure local model loading here.
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=gpt-4.1-mini
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
ENABLE_LLM=true

# OCR. pytesseract requires the Tesseract executable installed on the host.
TESSERACT_CMD=
TESSDATA_DIR=
OCR_LANGUAGES=chi_sim+eng
