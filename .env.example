APP_NAME=企业级多源合同智能审查系统 API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
LOG_LEVEL=INFO

# Upload and report storage
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=120

# Authentication. Production must replace these values.
JWT_SECRET_KEY=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!

# PostgreSQL / Redis / Celery. Local compatibility mode is disabled by default.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+psycopg://contract_review:contract_review@localhost:5432/contract_review
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External LLM API only. Do not configure local model loading here.
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=gpt-4.1-mini
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
ENABLE_LLM=true

# OCR. pytesseract requires the Tesseract executable installed on the host.
TESSERACT_CMD=
LIBREOFFICE_CMD=
TESSDATA_DIR=
OCR_LANGUAGES=chi_sim+eng
